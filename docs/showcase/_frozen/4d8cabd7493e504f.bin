  <rect width="420" height="300" fill="#FFFFFF"/>
  <rect x="18" y="18" width="32" height="32" fill="#6E8B3D" fill-opacity="0.42" stroke="#6E8B3D" stroke-width="1.4"/><rect x="56" y="18" width="32" height="32" fill="#6E8B3D" fill-opacity="0.42" stroke="#6E8B3D" stroke-width="1.4"/><rect x="94" y="18" width="32" height="32" fill="#6E8B3D" fill-opacity="0.42" stroke="#6E8B3D" stroke-width="1.4"/><rect x="132" y="18" width="32" height="32" fill="#6E8B3D" fill-opacity="0.42" stroke="#6E8B3D" stroke-width="1.4"/><rect x="170" y="18" width="32" height="32" fill="#6E8B3D" fill-opacity="0.42" stroke="#6E8B3D" stroke-width="1.4"/><rect x="208" y="18" width="32" height="32" fill="#6E8B3D" fill-opacity="0.42" stroke="#6E8B3D" stroke-width="1.4"/><rect x="246" y="18" width="32" height="32" fill="#6E8B3D" fill-opacity="0.42" stroke="#6E8B3D" stroke-width="1.4"/><rect x="284" y="18" width="32" height="32" fill="#6E8B3D" fill-opacity="0.42" stroke="#6E8B3D" stroke-width="1.4"/><rect x="322" y="18" width="32" height="32" fill="#6E8B3D" fill-opacity="0.42" stroke="#6E8B3D" stroke-width="1.4"/><rect x="360" y="18" width="32" height="32" fill="#6E8B3D" fill-opacity="0.42" stroke="#6E8B3D" stroke-width="1.4"/><rect x="18" y="56" width="32" height="32" fill="#6E8B3D" fill-opacity="0.42" stroke="#6E8B3D" stroke-width="1.4"/><rect x="56" y="56" width="32" height="32" fill="#6E8B3D" fill-opacity="0.42" stroke="#6E8B3D" stroke-width="1.4"/><rect x="94" y="56" width="32" height="32" fill="#6E8B3D" fill-opacity="0.42" stroke="#6E8B3D" stroke-width="1.4"/><rect x="132" y="56" width="32" height="32" fill="#6E8B3D" fill-opacity="0.42" stroke="#6E8B3D" stroke-width="1.4"/><rect x="170" y="56" width="32" height="32" fill="#6E8B3D" fill-opacity="0.42" stroke="#6E8B3D" stroke-width="1.4"/><rect x="208" y="56" width="32" height="32" fill="#6E8B3D" fill-opacity="0.42" stroke="#6E8B3D" stroke-width="1.4"/><rect x="246" y="56" width="32" height="32" fill="#6E8B3D" fill-opacity="0.42" stroke="#6E8B3D" stroke-width="1.4"/><rect x="284" y="56" width="32" 