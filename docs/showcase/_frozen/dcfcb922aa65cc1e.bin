<body class="wp-singular page-template page-template-elementor_canvas page page-id-191 wp-embed-responsive wp-theme-twentytwentyfive elementor-default elementor-template-canvas elementor-kit-4 elementor-page elementor-page-191">
			<div data-elementor-type="wp-page" data-elementor-id="191" class="elementor elementor-191">
				<div class="elementor-element elementor-element-e00000 e-con e-atomic-element e-flexbox-base e-ykrhga-e00000-s " data-id="e00000" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e00000">
    <div class="elementor-element elementor-element-e00001 e-con e-atomic-element e-flexbox-base e-ykrhga-e00001-s " data-id="e00001" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e00001">
    <div class="elementor-element elementor-element-e00002 e-con e-atomic-element e-flexbox-base e-ykrhga-e00002-s " data-id="e00002" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e00002">
    			<p class="e-ykrhga-e00003-s e-paragraph-base" data-interaction-id="e00003">RIDGELINE ROOF &amp; GUTTER</p>
		<div class="elementor-element elementor-element-e00004 e-con e-atomic-element e-flexbox-base e-ykrhga-e00004-s " data-id="e00004" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e00004">
    			<p class="e-ykrhga-e00005-s e-paragraph-base" data-interaction-id="e00005"><a href="tel:+15555550142" target="_self" class="e-paragraph-link-base">
		Call the yard direct: (555) 555-0142, 7am to 6pm
	</a></p>
					<p class="e-ykrhga-e00006-s e-paragraph-base" data-interaction-id="e00006">Whitcomb County only · Yard at 2210 Kestrel Road</p>
		
</div>

</div>

</div>
<div class="elementor-element elementor-element-e00007 e-con e-atomic-element e-flexbox-base e-ykrhga-e00007-s " data-id="e00007" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e00007">
    <div class="elementor-element elementor-element-e00008 e-con e-atomic-element e-grid-base e-ykrhga-e00008-s " data-id="e00008" data-element_type="e-grid" data-e-type="e-grid" data-interaction-id="e00008">
    <div class="elementor-element elementor-element-e00009 e-con e-atomic-element e-flexbox-base e-ykrhga-e00009-s " data-id="e00009" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e00009">
    			<p class="e-ykrhga-e0000a-s e-paragraph-base" data-interaction-id="e0000a">TWO CREWS · ONE COUNTY · NO BROKERS</p>
					<h1 data-interaction-id="e0000b" class="e-ykrhga-e0000b-s e-heading-base">A roof quote with the numbers left in.</h1>
					<p class="e-ykrhga-e0000c-s e-paragraph-base" data-interaction-id="e0000c">We are two crews covering Whitcomb County. You get a fixed price, a start date, and the name of the person who will be on your roof. No lead brokers, no financing upsell, no mystery line items.</p>
		<div class="elementor-element elementor-element-e0000d e-con e-atomic-element e-flexbox-base e-ykrhga-e0000d-s " data-id="e0000d" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0000d">
    			<p class="e-ykrhga-e0000e-s e-paragraph-base" data-interaction-id="e0000e"><a href="#book" target="_self" class="e-paragraph-link-base">
		Get a fixed quote
	</a></p>
					<p class="e-ykrhga-e0000f-s e-paragraph-base" data-interaction-id="e0000f"><a href="tel:+15555550142" target="_self" class="e-paragraph-link-base">
		Or call (555) 555-0142
	</a></p>
		
</div>
<div class="elementor-element elementor-element-e0000g e-con e-atomic-element e-flexbox-base e-ykrhga-e0000g-s " data-id="e0000g" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0000g">
    <div class="elementor-element elementor-element-e0000h e-con e-atomic-element e-flexbox-base e-ykrhga-e0000h-s " data-id="e0000h" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0000h">
    
</div>
			<p class="e-ykrhga-e0000i-s e-paragraph-base" data-interaction-id="e0000i">Next open start date: 9 days out. Emergency tarping same day.</p>
		
</div>

</div>
<div class="elementor-element elementor-element-e0000j e-con e-atomic-element e-flexbox-base e-ykrhga-e0000j-s " data-id="e0000j" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0000j">
    			<img fetchpriority="high" decoding="async" class="e-image-base e-ykrhga-e0000k-s" data-interaction-id="e0000k" id="189" src="http://127.0.0.1:8950/wp-content/uploads/2026/08/exjsx-ridgeline-roofing-crew_working.jpg" width="1024" height="576" srcset="http://127.0.0.1:8950/wp-content/uploads/2026/08/exjsx-ridgeline-roofing-crew_working.jpg 1024w, http://127.0.0.1:8950/wp-content/uploads/2026/08/exjsx-ridgeline-roofing-crew_working-300x169.jpg 300w, http://127.0.0.1:8950/wp-content/uploads/2026/08/exjsx-ridgeline-roofing-crew_working-768x432.jpg 768w" alt="A Ridgeline crew working on a residential asphalt roof"/>		<div class="elementor-element elementor-element-e0000l e-con e-atomic-element e-flexbox-base e-ykrhga-e0000l-s " data-id="e0000l" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0000l">
    			<p class="e-ykrhga-e0000m-s e-paragraph-base" data-interaction-id="e0000m">THE NUMBER PEOPLE ACTUALLY WANT</p>
					<p class="e-ykrhga-e0000n-s e-paragraph-base" data-interaction-id="e0000n">Typical full re-roof, 1,800 sq ft asphalt: <em>11,400 to 16,900 dollars</em> including tear-off.</p>
					<p class="e-ykrhga-e0000o-s e-paragraph-base" data-interaction-id="e0000o">Your house gets its own number after we walk it. That number does not move once it is signed.</p>
		
</div>

</div>

</div>

</div>
<div class="elementor-element elementor-element-e0000p e-con e-atomic-element e-flexbox-base e-ykrhga-e0000p-s " data-id="e0000p" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0000p">
    <div class="elementor-element elementor-element-e0000q e-con e-atomic-element e-flexbox-base e-ykrhga-e0000q-s " data-id="e0000q" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0000q">
    <div class="elementor-element elementor-element-e0000r e-con e-atomic-element e-flexbox-base e-ykrhga-e0000r-s " data-id="e0000r" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0000r">
    <div class="elementor-element elementor-element-e0000s e-con e-atomic-element e-flexbox-base e-ykrhga-e0000s-s " data-id="e0000s" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0000s">
    			<p class="e-ykrhga-e0000t-s e-paragraph-base" data-interaction-id="e0000t">THE LEDGER</p>
					<h2 data-interaction-id="e0000u" class="e-ykrhga-e0000u-s e-heading-base">What we charge, next to what a call-centre quote hides.</h2>
		
</div>
			<p class="e-ykrhga-e0000v-s e-paragraph-base" data-interaction-id="e0000v">Same 1,800 sq ft roof, same shingle, same county. The difference is which line items you are told about before the crew arrives.</p>
		
</div>
<div class="elementor-element elementor-element-e0000w e-con e-atomic-element e-grid-base e-ykrhga-e0000w-s " data-id="e0000w" data-element_type="e-grid" data-e-type="e-grid" data-interaction-id="e0000w">
    <div class="elementor-element elementor-element-e0000x e-con e-atomic-element e-flexbox-base e-ykrhga-e0000x-s " data-id="e0000x" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0000x">
    <div class="elementor-element elementor-element-e0000y e-con e-atomic-element e-flexbox-base e-ykrhga-e0000y-s " data-id="e0000y" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0000y">
    			<p class="e-ykrhga-e0000z-s e-paragraph-base" data-interaction-id="e0000z">RIDGELINE — ALL IN THE NUMBER</p>
					<h3 data-interaction-id="e00010" class="e-ykrhga-e00010-s e-heading-base">One price. One page. One crew you meet first.</h3>
		
</div>
<div class="elementor-element elementor-element-e00011 e-con e-atomic-element e-flexbox-base e-ykrhga-e00011-s " data-id="e00011" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e00011">
    
</div>
<div class="elementor-element elementor-element-e00012 e-con e-atomic-element e-flexbox-base e-ykrhga-e00012-s " data-id="e00012" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e00012">
    <div class="elementor-element elementor-element-e00013 e-con e-atomic-element e-flexbox-base e-ykrhga-e00013-s " data-id="e00013" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e00013">
    			<p class="e-ykrhga-e00014-s e-paragraph-base" data-interaction-id="e00014">Tear-off, all layers</p>
					<p class="e-ykrhga-e00015-s e-paragraph-base" data-interaction-id="e00015">included</p>
		
</div>
<div class="elementor-element elementor-element-e00016 e-con e-atomic-element e-flexbox-base e-ykrhga-e00016-s " data-id="e00016" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e00016">
    
</div>

</div>
<div class="elementor-element elementor-element-e00017 e-con e-atomic-element e-flexbox-base e-ykrhga-e00017-s " data-id="e00017" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e00017">
    <div class="elementor-element elementor-element-e00018 e-con e-atomic-element e-flexbox-base e-ykrhga-e00018-s " data-id="e00018" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e00018">
    			<p class="e-ykrhga-e00019-s e-paragraph-base" data-interaction-id="e00019">Skip hire and disposal</p>
					<p class="e-ykrhga-e0001a-s e-paragraph-base" data-interaction-id="e0001a">included</p>
		
</div>
<div class="elementor-element elementor-element-e0001b e-con e-atomic-element e-flexbox-base e-ykrhga-e0001b-s " data-id="e0001b" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0001b">
    
</div>

