    			<p class="e-ykrhga-e0000k-s e-paragraph-base" data-interaction-id="e0000k">STANDARD CONFIGURATION</p>
					<p class="e-ykrhga-e0000l-s e-paragraph-base" data-interaction-id="e0000l">Standard bore DN200 Class 600, F316 body, stellite seat, 14 week lead. Reduced bore available on the same lead time.</p>
		<div class="elementor-element elementor-element-e0000m e-con e-atomic-element e-flexbox-base e-ykrhga-e0000m-s " data-id="e0000m" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0000m">
    
