    			<p class="e-hu2hyx-e0000v-s e-paragraph-base" data-interaction-id="e0000v">Limitation of liability</p>
					<p class="e-hu2hyx-e0000w-s e-paragraph-base" data-interaction-id="e0000w">Uncapped indirect loss, mutual vs one-way caps, carve-out asymmetry</p>
		<div class="elementor-element elementor-element-e0000x e-con e-atomic-element e-flexbox-base e-hu2hyx-e0000x-s " data-id="e0000x" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0000x">
