    <div class="elementor-element elementor-element-e0006p e-con e-atomic-element e-flexbox-base e-ykrhga-e0006p-s " data-id="e0006p" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0006p">
    			<p class="e-ykrhga-e0006q-s e-paragraph-base" data-interaction-id="e0006q">84p LAND</p>
		
</div>
<div class="elementor-element elementor-element-e0006r e-con e-atomic-element e-flexbox-base e-ykrhga-e0006r-s " data-id="e0006r" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0006r">
    			<p class="e-ykrhga-e0006s-s e-paragraph-base" data-interaction-id="e0006s">16p</p>
		
</div>

</div>
			<p class="e-ykrhga-e0006t-s e-paragraph-base" data-interaction-id="e0006t">Year ended 31 March 2026 · income £2,441,900 · independently examined</p>
		
</div>
<div class="elementor-element elementor-element-e0006u e-con e-atomic-element e-flexbox-base e-ykrhga-e0006u-s " data-id="e0006u" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0006u">
