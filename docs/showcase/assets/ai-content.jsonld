{
  "$comment_1": "JSON-LD template for a sandbox demo page. Substitute {{BRAND}}, {{SECTOR}}, {{URL}}. Emit exactly ONE ld+json block per sandbox page — this one. See indexing-ruling.json hard_rules: no LocalBusiness / MedicalBusiness / Organization / Review / AggregateRating / Person markup on these pages, ever.",
  "$comment_2": "Design note: this block describes the PAGE as a fictional demonstration. It deliberately does NOT describe the fictional business as an entity, because doing so is what Google's structured data policy prohibits ('Don't impersonate any person or organization, or misrepresent your ownership, affiliation, or primary purpose'). The `about` node names the business only in order to say it does not exist.",
  "$comment_3": "Honest limitation: there is NO schema.org vocabulary for 'this content is fictional'. No Fiction, FictionalWork, Parody, Synthetic, Demo or AIGenerated type exists, and no pending proposal fills the gap. SatiricalArticle is Article-scoped; SatireOrParodyContent belongs to MediaReview, which is third-party fact-checker markup about someone else's media, not self-labelling. So the fictional-ness is carried in free-text fields (creativeWorkStatus, disambiguatingDescription, abstract) that no consumer parses semantically. The load-bearing disclosure is the visible banner. Treat this block as supporting evidence of good faith, not as a control.",

  "$comment_5": "PUBLISHER / ATTRIBUTION SCOPE — read before changing the `publisher` node. An earlier revision of verify-disclosure.py rejected @type Organization ANYWHERE in this document, and build.py mirrored that rule and silently dropped `publisher` with a warning. That was wrong on both sides, and the two assets have now been reconciled in favour of keeping the node. The prohibition Google actually states is 'Don't impersonate any person or organization, or misrepresent your ownership, affiliation, or primary purpose.' Naming the REAL publisher of the page is not impersonation — it is the disclosure of ownership that policy is asking for, and it is the one node on a fictional page that identifies a real, accountable, contactable entity. What must never appear is an Organization (or LocalBusiness / Person / Review / Offer …) node describing the FICTIONAL BUSINESS. So the rule is scoped by position, not by type: forbidden types are rejected everywhere EXCEPT inside the attribution branches — publisher, creator, provider, sourceOrganization, copyrightHolder, funder — which by definition describe the real publisher and not the subject of the page. verify-disclosure.py check D5 implements exactly that scoping. build.py's FORBIDDEN_SD_TYPES drop still needs the same narrowing; see agents/legal/FIXES.md F-16 for the three-line change. Until it lands the built pages simply omit publisher, which loses a good-faith signal but breaks nothing.",

  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "{{URL}}",
  "url": "{{URL}}",
  "name": "[Fictional demo] {{BRAND}}",
  "inLanguage": "en-GB",
  "isAccessibleForFree": true,

  "creativeWorkStatus": "Fictional AI-generated demonstration",
  "genre": "Fiction",

  "abstract": "{{BRAND}} is a fictional business that does not exist. This {{SECTOR}} page and everything on it — text, statistics, prices, reviews, named people, professional credentials, certifications and images — was generated by AI as a design demonstration for the exjsx toolchain. Nothing on this page is a real offer, a real endorsement, a real qualification, or professional advice.",

  "disambiguatingDescription": "Fictional demonstration page. {{BRAND}} is not a real business. Any resemblance to a real organisation or person is unintended.",

  "digitalSourceType": "https://schema.org/TrainedAlgorithmicMediaDigitalSource",
  "$comment_4": "schema.org/digitalSourceType was added in v24.0 (2024-01-09) to help address responsible use of generative AI, but is still `pending` with under 1K domains using it and no Google feature consuming it. Included for completeness. The signal Google actually reads is embedded IPTC XMP DigitalSourceType in the image binaries — see indexing-ruling.json § images.",

  "usageInfo": "https://exjsx.dev/showcase/terms/",
  "license": "https://exjsx.dev/showcase/terms/",

  "creator": {
    "@type": "SoftwareApplication",
    "name": "exjsx",
    "applicationCategory": "DeveloperApplication",
    "url": "https://exjsx.dev/"
  },

  "publisher": {
    "@type": "Organization",
    "name": "Algorismus LLC",
    "url": "https://exjsx.dev/",
    "email": "legal@wpos.ai",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "3001 Hulen Street, Suite 201",
      "addressLocality": "Fort Worth",
      "addressRegion": "TX",
      "postalCode": "76107",
      "addressCountry": "US"
    }
  },

  "about": {
    "@type": "Thing",
    "name": "{{BRAND}}",
    "description": "{{BRAND}} is a fictional entity invented by AI for this demonstration. It is not a real organisation. It has no premises, staff, products, customers, registrations or accreditations. The people, qualifications, certifications, reviews, prices and statistics shown on this page are fabricated."
  },

  "mainContentOfPage": {
    "@type": "WebPageElement",
    "cssSelector": ".exjsx-dsc",
    "description": "Persistent content notice identifying this page as a fictional AI-generated demonstration."
  }
}
