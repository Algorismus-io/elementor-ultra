<body class="wp-singular page-template page-template-elementor_canvas page page-id-166 wp-embed-responsive wp-theme-twentytwentyfive elementor-default elementor-template-canvas elementor-kit-4 elementor-page elementor-page-166">
			<div data-elementor-type="wp-page" data-elementor-id="166" class="elementor elementor-166">
						<div class="elementor-element elementor-element-e00000 elementor-widget elementor-widget-html" data-id="e00000" data-element_type="widget" data-e-type="widget" data-widget_type="html.default">
					<style id="exjsx-raw-ykrhga-0">.elementor-element-e00000{margin:0 !important;height:0;line-height:0;}.elementor .e-ykrhga-e00005-s.e-ykrhga-e00005-s{text-transform: uppercase;}.elementor .e-ykrhga-e00009-s.e-ykrhga-e00009-s{text-transform: uppercase;}.elementor .e-ykrhga-e0000g-s.e-ykrhga-e0000g-s{text-transform: uppercase;}.elementor .e-ykrhga-e0001v-s.e-ykrhga-e0001v-s{text-transform: uppercase;}.elementor .e-ykrhga-e0002r-s.e-ykrhga-e0002r-s{text-transform: uppercase;}.elementor .e-ykrhga-e0003h-s.e-ykrhga-e0003h-s{text-transform: uppercase;}.elementor .e-ykrhga-e00049-s.e-ykrhga-e00049-s{text-transform: uppercase;}.elementor .e-ykrhga-e0004h-s.e-ykrhga-e0004h-s{text-transform: uppercase;}.elementor .e-ykrhga-e00056-s.e-ykrhga-e00056-s{text-transform: uppercase;}.elementor .e-ykrhga-e0005a-s.e-ykrhga-e0005a-s{text-transform: uppercase;}</style>				</div>
		<div class="elementor-element elementor-element-e00001 e-con e-atomic-element e-flexbox-base e-ykrhga-e00001-s " data-id="e00001" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e00001">
    <section class="elementor-element elementor-element-e00002 e-con e-atomic-element e-flexbox-base e-ykrhga-e00002-s " data-id="e00002" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e00002">
    <div class="elementor-element elementor-element-e00003 e-con e-atomic-element e-grid-base e-ykrhga-e00003-s " data-id="e00003" data-element_type="e-grid" data-e-type="e-grid" data-interaction-id="e00003">
    <div class="elementor-element elementor-element-e00004 e-con e-atomic-element e-flexbox-base e-ykrhga-e00004-s " data-id="e00004" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e00004">
    			<p class="e-ykrhga-e00005-s e-paragraph-base" data-interaction-id="e00005">Onsen Mirador · Geothermal bathhouse</p>
					<h1 data-interaction-id="e00006" class="e-ykrhga-e00006-s e-heading-base">Water, heat, cold, silence. Nothing else is offered.</h1>
					<p class="e-ykrhga-e00007-s e-paragraph-base" data-interaction-id="e00007">A geothermal bathhouse of six pools cut into basalt, open in three-hour sessions with a maximum of forty bathers. There are no treatments, no music and no phones past the lockers.</p>
		<div class="elementor-element elementor-element-e00008 e-con e-atomic-element e-flexbox-base e-ykrhga-e00008-s " data-id="e00008" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e00008">
    			<p class="e-ykrhga-e00009-s e-paragraph-base" data-interaction-id="e00009"><a href="#reserve" target="_self" class="e-paragraph-link-base">
		Reserve a session
	</a></p>
					<p class="e-ykrhga-e0000a-s e-paragraph-base" data-interaction-id="e0000a">48 for three hours · five sessions a day</p>
		
</div>

</div>
<div class="elementor-element elementor-element-e0000b e-con e-atomic-element e-flexbox-base e-ykrhga-e0000b-s " data-id="e0000b" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0000b">
    			<img fetchpriority="high" decoding="async" class="e-image-base e-ykrhga-e0000c-s" data-interaction-id="e0000c" id="163" src="http://127.0.0.1:8950/wp-content/uploads/2026/08/exjsx-onsen-mirador-onsen_steam_pool.jpg" width="768" height="1024" srcset="http://127.0.0.1:8950/wp-content/uploads/2026/08/exjsx-onsen-mirador-onsen_steam_pool.jpg 768w, http://127.0.0.1:8950/wp-content/uploads/2026/08/exjsx-onsen-mirador-onsen_steam_pool-225x300.jpg 225w" alt="Steam rising off the surface of a geothermal pool cut into basalt"/>		
</div>

</div>

</section>
<section class="elementor-element elementor-element-e0000d e-con e-atomic-element e-flexbox-base e-ykrhga-e0000d-s " data-id="e0000d" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0000d">
    <div class="elementor-element elementor-element-e0000e e-con e-atomic-element e-grid-base e-ykrhga-e0000e-s " data-id="e0000e" data-element_type="e-grid" data-e-type="e-grid" data-interaction-id="e0000e">
    <div class="elementor-element elementor-element-e0000f e-con e-atomic-element e-flexbox-base e-ykrhga-e0000f-s " data-id="e0000f" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0000f">
    			<p class="e-ykrhga-e0000g-s e-paragraph-base" data-interaction-id="e0000g">Six pools</p>
					<h2 data-interaction-id="e0000h" class="e-ykrhga-e0000h-s e-heading-base">Each pool has one temperature and one purpose.</h2>
					<p class="e-ykrhga-e0000i-s e-paragraph-base" data-interaction-id="e0000i">Cut into basalt and fed from the same spring at ninety-one degrees, cooled in stages. The numbers on the wall are the numbers in the water; we do not round them for comfort.</p>
		
</div>
<div class="elementor-element elementor-element-e0000j e-con e-atomic-element e-flexbox-base e-ykrhga-e0000j-s " data-id="e0000j" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0000j">
    <div class="elementor-element elementor-element-e0000k e-con e-atomic-element e-flexbox-base e-ykrhga-e0000k-s " data-id="e0000k" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0000k">
    <div class="elementor-element elementor-element-e0000l e-con e-atomic-element e-flexbox-base e-ykrhga-e0000l-s " data-id="e0000l" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0000l">
    <div class="elementor-element elementor-element-e0000m e-con e-atomic-element e-flexbox-base e-ykrhga-e0000m-s " data-id="e0000m" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0000m">
    			<h3 data-interaction-id="e0000n" class="e-ykrhga-e0000n-s e-heading-base">The Source</h3>
					<p class="e-ykrhga-e0000o-s e-paragraph-base" data-interaction-id="e0000o">42°</p>
		
</div>
			<p class="e-ykrhga-e0000p-s e-paragraph-base" data-interaction-id="e0000p">Where you start and where you should stay for at least twenty minutes before anything else.</p>
		
</div>

</div>
<div class="elementor-element elementor-element-e0000q e-con e-atomic-element e-flexbox-base e-ykrhga-e0000q-s " data-id="e0000q" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0000q">
    <div class="elementor-element elementor-element-e0000r e-con e-atomic-element e-flexbox-base e-ykrhga-e0000r-s " data-id="e0000r" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0000r">
    
</div>
<div class="elementor-element elementor-element-e0000s e-con e-atomic-element e-flexbox-base e-ykrhga-e0000s-s " data-id="e0000s" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0000s">
    <div class="elementor-element elementor-element-e0000t e-con e-atomic-element e-flexbox-base e-ykrhga-e0000t-s " data-id="e0000t" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0000t">
    			<h3 data-interaction-id="e0000u" class="e-ykrhga-e0000u-s e-heading-base">The Cold Well</h3>
					<p class="e-ykrhga-e0000v-s e-paragraph-base" data-interaction-id="e0000v">6°</p>
		
</div>
			<p class="e-ykrhga-e0000w-s e-paragraph-base" data-interaction-id="e0000w">Ninety seconds is enough. Breathe out slowly on the way in and do not gasp.</p>
		
</div>

</div>
<div class="elementor-element elementor-element-e0000x e-con e-atomic-element e-flexbox-base e-ykrhga-e0000x-s " data-id="e0000x" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0000x">
    <div class="elementor-element elementor-element-e0000y e-con e-atomic-element e-flexbox-base e-ykrhga-e0000y-s " data-id="e0000y" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0000y">
    
</div>
<div class="elementor-element elementor-element-e0000z e-con e-atomic-element e-flexbox-base e-ykrhga-e0000z-s " data-id="e0000z" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0000z">
    <div class="elementor-element elementor-element-e00010 e-con e-atomic-element e-flexbox-base e-ykrhga-e00010-s " data-id="e00010" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e00010">
    			<h3 data-interaction-id="e00011" class="e-ykrhga-e00011-s e-heading-base">The Long Pool</h3>
					<p class="e-ykrhga-e00012-s e-paragraph-base" data-interaction-id="e00012">37°</p>
		
</div>
			<p class="e-ykrhga-e00013-s e-paragraph-base" data-interaction-id="e00013">Twenty-eight metres, open to the sky in all weather. This is the one people come back for.</p>
		
</div>

</div>
<div class="elementor-element elementor-element-e00014 e-con e-atomic-element e-flexbox-base e-ykrhga-e00014-s " data-id="e00014" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e00014">
    <div class="elementor-element elementor-element-e00015 e-con e-atomic-element e-flexbox-base e-ykrhga-e00015-s " data-id="e00015" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e00015">
    
</div>
<div class="elementor-element elementor-element-e00016 e-con e-atomic-element e-flexbox-base e-ykrhga-e00016-s " data-id="e00016" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e00016">
    <div class="elementor-element elementor-element-e00017 e-con e-atomic-element e-flexbox-base e-ykrhga-e00017-s " data-id="e00017" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e00017">
    			<h3 data-interaction-id="e00018" class="e-ykrhga-e00018-s e-heading-base">The Steam Room</h3>
					<p class="e-ykrhga-e00019-s e-paragraph-base" data-interaction-id="e00019">45°</p>
		
</div>
			<p class="e-ykrhga-e0001a-s e-paragraph-base" data-interaction-id="e0001a">Saturated and unlit. Sit low, breathe through the nose, and leave before you want to.</p>
		
</div>

</div>
<div class="elementor-element elementor-element-e0001b e-con e-atomic-element e-flexbox-base e-ykrhga-e0001b-s " data-id="e0001b" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0001b">
    <div class="elementor-element elementor-element-e0001c e-con e-atomic-element e-flexbox-base e-ykrhga-e0001c-s " data-id="e0001c" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0001c">
    
</div>
<div class="elementor-element elementor-element-e0001d e-con e-atomic-element e-flexbox-base e-ykrhga-e0001d-s " data-id="e0001d" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0001d">
    <div class="elementor-element elementor-element-e0001e e-con e-atomic-element e-flexbox-base e-ykrhga-e0001e-s " data-id="e0001e" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0001e">
    			<h3 data-interaction-id="e0001f" class="e-ykrhga-e0001f-s e-heading-base">The Ash Pool</h3>
					<p class="e-ykrhga-e0001g-s e-paragraph-base" data-interaction-id="e0001g">39°</p>
		
</div>
			<p class="e-ykrhga-e0001h-s e-paragraph-base" data-interaction-id="e0001h">Mineral heavy and dark. Good for shoulders, and better in the second half of a session.</p>
		
</div>

</div>
<div class="elementor-element elementor-element-e0001i e-con e-atomic-element e-flexbox-base e-ykrhga-e0001i-s " data-id="e0001i" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0001i">
    <div class="elementor-element elementor-element-e0001j e-con e-atomic-element e-flexbox-base e-ykrhga-e0001j-s " data-id="e0001j" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0001j">
    
</div>
<div class="elementor-element elementor-element-e0001k e-con e-atomic-element e-flexbox-base e-ykrhga-e0001k-s " data-id="e0001k" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0001k">
    <div class="elementor-element elementor-element-e0001l e-con e-atomic-element e-flexbox-base e-ykrhga-e0001l-s " data-id="e0001l" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0001l">
    			<h3 data-interaction-id="e0001m" class="e-ykrhga-e0001m-s e-heading-base">The Shallow</h3>
					<p class="e-ykrhga-e0001n-s e-paragraph-base" data-interaction-id="e0001n">33°</p>
		
</div>
			<p class="e-ykrhga-e0001o-s e-paragraph-base" data-interaction-id="e0001o">Knee deep and lit from below. Where you go when hot is too much and cold is too far.</p>
		
</div>

</div>

</div>

</div>

</section>
<section class="elementor-element elementor-element-e0001p e-con e-atomic-element e-flexbox-base e-ykrhga-e0001p-s " data-id="e0001p" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0001p">
    <div class="elementor-element elementor-element-e0001q e-con e-atomic-element e-grid-base e-ykrhga-e0001q-s " data-id="e0001q" data-element_type="e-grid" data-e-type="e-grid" data-interaction-id="e0001q">
    <div class="elementor-element elementor-element-e0001r e-con e-atomic-element e-flexbox-base e-ykrhga-e0001r-s " data-id="e0001r" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0001r">
    			<img decoding="async" class="e-image-base e-ykrhga-e0001s-s" data-interaction-id="e0001s" id="165" src="http://127.0.0.1:8950/wp-content/uploads/2026/08/exjsx-onsen-mirador-onsen_long_pool.jpg" width="1024" height="576" srcset="http://127.0.0.1:8950/wp-content/uploads/2026/08/exjsx-onsen-mirador-onsen_long_pool.jpg 1024w, http://127.0.0.1:8950/wp-content/uploads/2026/08/exjsx-onsen-mirador-onsen_long_pool-300x169.jpg 300w, http://127.0.0.1:8950/wp-content/uploads/2026/08/exjsx-onsen-mirador-onsen_long_pool-768x432.jpg 768w" alt="The long pool, twenty-eight metres open to the sky"/>		
</div>
<div class="elementor-element elementor-element-e0001t e-con e-atomic-element e-flexbox-base e-ykrhga-e0001t-s " data-id="e0001t" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0001t">
    <div class="elementor-element elementor-element-e0001u e-con e-atomic-element e-flexbox-base e-ykrhga-e0001u-s " data-id="e0001u" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0001u">
    			<p class="e-ykrhga-e0001v-s e-paragraph-base" data-interaction-id="e0001v">The circuit · three hours</p>
					<h2 data-interaction-id="e0001w" class="e-ykrhga-e0001w-s e-heading-base">Hot for twenty, cold for two, rest for ten.</h2>
					<p class="e-ykrhga-e0001x-s e-paragraph-base" data-interaction-id="e0001x">Repeat three times, then an hour in the long pool. That is the circuit and there is no other advice.</p>
		
</div>
<div class="elementor-element elementor-element-e0001y e-con e-atomic-element e-flexbox-base e-ykrhga-e0001y-s " data-id="e0001y" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0001y">
    <div class="elementor-element elementor-element-e0001z e-con e-atomic-element e-flexbox-base e-ykrhga-e0001z-s " data-id="e0001z" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0001z">
    			<p class="e-ykrhga-e00020-s e-paragraph-base" data-interaction-id="e00020">01</p>
		<div class="elementor-element elementor-element-e00021 e-con e-atomic-element e-flexbox-base e-ykrhga-e00021-s " data-id="e00021" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e00021">
    			<h3 data-interaction-id="e00022" class="e-ykrhga-e00022-s e-heading-base">Hot for twenty</h3>
					<p class="e-ykrhga-e00023-s e-paragraph-base" data-interaction-id="e00023">The Source, unhurried. You are not warm until your shoulders drop.</p>
		
</div>

</div>
<div class="elementor-element elementor-element-e00024 e-con e-atomic-element e-flexbox-base e-ykrhga-e00024-s " data-id="e00024" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e00024">
    			<p class="e-ykrhga-e00025-s e-paragraph-base" data-interaction-id="e00025">02</p>
		<div class="elementor-element elementor-element-e00026 e-con e-atomic-element e-flexbox-base e-ykrhga-e00026-s " data-id="e00026" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e00026">
    			<h3 data-interaction-id="e00027" class="e-ykrhga-e00027-s e-heading-base">Cold for two</h3>
					<p class="e-ykrhga-e00028-s e-paragraph-base" data-interaction-id="e00028">The Cold Well. Long exhale on entry, ninety seconds, out before you shiver.</p>
		
</div>

</div>
<div class="elementor-element elementor-element-e00029 e-con e-atomic-element e-flexbox-base e-ykrhga-e00029-s " data-id="e00029" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e00029">
    			<p class="e-ykrhga-e0002a-s e-paragraph-base" data-interaction-id="e0002a">03</p>
		<div class="elementor-element elementor-element-e0002b e-con e-atomic-element e-flexbox-base e-ykrhga-e0002b-s " data-id="e0002b" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0002b">
    			<h3 data-interaction-id="e0002c" class="e-ykrhga-e0002c-s e-heading-base">Rest for ten</h3>
					<p class="e-ykrhga-e0002d-s e-paragraph-base" data-interaction-id="e0002d">Cedar bench, no towel over the face, no counting. Let the heat finish moving.</p>
		
</div>

</div>
<div class="elementor-element elementor-element-e0002e e-con e-atomic-element e-flexbox-base e-ykrhga-e0002e-s " data-id="e0002e" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0002e">
    			<p class="e-ykrhga-e0002f-s e-paragraph-base" data-interaction-id="e0002f">04</p>
		<div class="elementor-element elementor-element-e0002g e-con e-atomic-element e-flexbox-base e-ykrhga-e0002g-s " data-id="e0002g" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0002g">
    			<h3 data-interaction-id="e0002h" class="e-ykrhga-e0002h-s e-heading-base">Repeat three times</h3>
					<p class="e-ykrhga-e0002i-s e-paragraph-base" data-interaction-id="e0002i">The same three moves. The circuit works because it does not change.</p>
		
</div>

</div>
<div class="elementor-element elementor-element-e0002j e-con e-atomic-element e-flexbox-base e-ykrhga-e0002j-s " data-id="e0002j" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0002j">
    			<p class="e-ykrhga-e0002k-s e-paragraph-base" data-interaction-id="e0002k">05</p>
		<div class="elementor-element elementor-element-e0002l e-con e-atomic-element e-flexbox-base e-ykrhga-e0002l-s " data-id="e0002l" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0002l">
    			<h3 data-interaction-id="e0002m" class="e-ykrhga-e0002m-s e-heading-base">Then an hour in the long pool</h3>
					<p class="e-ykrhga-e0002n-s e-paragraph-base" data-interaction-id="e0002n">Thirty-seven degrees under open sky, until the session bell.</p>
		
</div>

</div>

</div>

</div>

</div>

</section>
<section class="elementor-element elementor-element-e0002o e-con e-atomic-element e-flexbox-base e-ykrhga-e0002o-s " data-id="e0002o" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0002o">
    <div class="elementor-element elementor-element-e0002p e-con e-atomic-element e-grid-base e-ykrhga-e0002p-s " data-id="e0002p" data-element_type="e-grid" data-e-type="e-grid" data-interaction-id="e0002p">
    <div class="elementor-element elementor-element-e0002q e-con e-atomic-element e-flexbox-base e-ykrhga-e0002q-s " data-id="e0002q" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0002q">
    			<p class="e-ykrhga-e0002r-s e-paragraph-base" data-interaction-id="e0002r">House rules</p>
					<h2 data-interaction-id="e0002s" class="e-ykrhga-e0002s-s e-heading-base">Stated plainly, so nobody has to ask.</h2>
		
</div>
<div class="elementor-element elementor-element-e0002t e-con e-atomic-element e-flexbox-base e-ykrhga-e0002t-s " data-id="e0002t" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0002t">
    			<p class="e-ykrhga-e0002u-s e-paragraph-base" data-interaction-id="e0002u">Silence is enforced past the threshold, kindly and consistently. Bathing is unclothed in the inner rooms and swimwear is required in the long pool. Phones stay in the lockers and we do not make exceptions.</p>
		<div class="elementor-element elementor-element-e0002v e-con e-atomic-element e-flexbox-base e-ykrhga-e0002v-s " data-id="e0002v" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0002v">
    
</div>
			<p class="e-ykrhga-e0002w-s e-paragraph-base" data-interaction-id="e0002w">If you need to be reachable, the desk will hold a number and come and find you. Staff use hand signals inside. A first reminder is a hand on the doorframe; there is rarely a second.</p>
		
</div>

</div>

</section>
<section class="elementor-element elementor-element-e0002x e-con e-atomic-element e-flexbox-base e-ykrhga-e0002x-s " data-id="e0002x" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0002x">
    <div class="elementor-element elementor-element-e0002y e-con e-atomic-element e-flexbox-base e-ykrhga-e0002y-s " data-id="e0002y" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0002y">
    			<h2 data-interaction-id="e0002z" class="e-ykrhga-e0002z-s e-heading-base">What we do not have.</h2>
					<p class="e-ykrhga-e00030-s e-paragraph-base" data-interaction-id="e00030">The list is short on purpose. Everything absent here is something that would otherwise interrupt three hours.</p>
		
</div>
<div class="elementor-element elementor-element-e00031 e-con e-atomic-element e-grid-base e-ykrhga-e00031-s " data-id="e00031" data-element_type="e-grid" data-e-type="e-grid" data-interaction-id="e00031">
    <div class="elementor-element elementor-element-e00032 e-con e-atomic-element e-flexbox-base e-ykrhga-e00032-s " data-id="e00032" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e00032">
    <div class="elementor-element elementor-element-e00033 e-con e-atomic-element e-flexbox-base e-ykrhga-e00033-s " data-id="e00033" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e00033">
    
</div>
			<h3 data-interaction-id="e00034" class="e-ykrhga-e00034-s e-heading-base">No treatments</h3>
					<p class="e-ykrhga-e00035-s e-paragraph-base" data-interaction-id="e00035">No massage, no scrubs, no wraps, nobody booked in to touch you. Water does the work.</p>
		
</div>
<div class="elementor-element elementor-element-e00036 e-con e-atomic-element e-flexbox-base e-ykrhga-e00036-s " data-id="e00036" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e00036">
    <div class="elementor-element elementor-element-e00037 e-con e-atomic-element e-flexbox-base e-ykrhga-e00037-s " data-id="e00037" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e00037">
    
</div>
			<h3 data-interaction-id="e00038" class="e-ykrhga-e00038-s e-heading-base">No bar</h3>
					<p class="e-ykrhga-e00039-s e-paragraph-base" data-interaction-id="e00039">Cold water, unlimited and free. Nothing to buy inside and nothing to carry between pools.</p>
		
</div>
<div class="elementor-element elementor-element-e0003a e-con e-atomic-element e-flexbox-base e-ykrhga-e0003a-s " data-id="e0003a" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0003a">
    <div class="elementor-element elementor-element-e0003b e-con e-atomic-element e-flexbox-base e-ykrhga-e0003b-s " data-id="e0003b" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0003b">
    
</div>
			<h3 data-interaction-id="e0003c" class="e-ykrhga-e0003c-s e-heading-base">No music</h3>
					<p class="e-ykrhga-e0003d-s e-paragraph-base" data-interaction-id="e0003d">No speakers, no playlist, no ambient soundtrack. Water on basalt is the whole programme.</p>
		
</div>

</div>

</section>
<section class="elementor-element elementor-element-e0003e e-con e-atomic-element e-flexbox-base e-ykrhga-e0003e-s " data-id="e0003e" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0003e">
    <div class="elementor-element elementor-element-e0003f e-con e-atomic-element e-grid-base e-ykrhga-e0003f-s " data-id="e0003f" data-element_type="e-grid" data-e-type="e-grid" data-interaction-id="e0003f">
    <div class="elementor-element elementor-element-e0003g e-con e-atomic-element e-flexbox-base e-ykrhga-e0003g-s " data-id="e0003g" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0003g">
    			<p class="e-ykrhga-e0003h-s e-paragraph-base" data-interaction-id="e0003h">Five sessions a day</p>
					<h2 data-interaction-id="e0003i" class="e-ykrhga-e0003i-s e-heading-base">Forty bathers per session, and never more.</h2>
		<div class="elementor-element elementor-element-e0003j e-con e-atomic-element e-flexbox-base e-ykrhga-e0003j-s " data-id="e0003j" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0003j">
    <div class="elementor-element elementor-element-e0003k e-con e-atomic-element e-flexbox-base e-ykrhga-e0003k-s " data-id="e0003k" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0003k">
    
</div>
<div class="elementor-element elementor-element-e0003l e-con e-atomic-element e-flexbox-base e-ykrhga-e0003l-s " data-id="e0003l" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0003l">
    			<p class="e-ykrhga-e0003m-s e-paragraph-base" data-interaction-id="e0003m">06:00</p>
					<p class="e-ykrhga-e0003n-s e-paragraph-base" data-interaction-id="e0003n">The quietest session. Rarely more than twenty bathers.</p>
		
</div>

</div>
<div class="elementor-element elementor-element-e0003o e-con e-atomic-element e-flexbox-base e-ykrhga-e0003o-s " data-id="e0003o" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0003o">
    <div class="elementor-element elementor-element-e0003p e-con e-atomic-element e-flexbox-base e-ykrhga-e0003p-s " data-id="e0003p" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0003p">
    
</div>
<div class="elementor-element elementor-element-e0003q e-con e-atomic-element e-flexbox-base e-ykrhga-e0003q-s " data-id="e0003q" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0003q">
    			<p class="e-ykrhga-e0003r-s e-paragraph-base" data-interaction-id="e0003r">09:00</p>
					<p class="e-ykrhga-e0003s-s e-paragraph-base" data-interaction-id="e0003s">Slow and half full. Good for a first visit.</p>
		
</div>

</div>
<div class="elementor-element elementor-element-e0003t e-con e-atomic-element e-flexbox-base e-ykrhga-e0003t-s " data-id="e0003t" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0003t">
    <div class="elementor-element elementor-element-e0003u e-con e-atomic-element e-flexbox-base e-ykrhga-e0003u-s " data-id="e0003u" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0003u">
    
</div>
<div class="elementor-element elementor-element-e0003v e-con e-atomic-element e-flexbox-base e-ykrhga-e0003v-s " data-id="e0003v" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0003v">
    			<p class="e-ykrhga-e0003w-s e-paragraph-base" data-interaction-id="e0003w">12:00</p>
					<p class="e-ykrhga-e0003x-s e-paragraph-base" data-interaction-id="e0003x">Fills late, empties fast.</p>
		
</div>

</div>
<div class="elementor-element elementor-element-e0003y e-con e-atomic-element e-flexbox-base e-ykrhga-e0003y-s " data-id="e0003y" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0003y">
    <div class="elementor-element elementor-element-e0003z e-con e-atomic-element e-flexbox-base e-ykrhga-e0003z-s " data-id="e0003z" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0003z">
    
</div>
<div class="elementor-element elementor-element-e00040 e-con e-atomic-element e-flexbox-base e-ykrhga-e00040-s " data-id="e00040" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e00040">
    			<p class="e-ykrhga-e00041-s e-paragraph-base" data-interaction-id="e00041">15:00</p>
					<p class="e-ykrhga-e00042-s e-paragraph-base" data-interaction-id="e00042">Steady. The long pool is warmest by now.</p>
		
</div>

</div>
<div class="elementor-element elementor-element-e00043 e-con e-atomic-element e-flexbox-base e-ykrhga-e00043-s " data-id="e00043" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e00043">
    <div class="elementor-element elementor-element-e00044 e-con e-atomic-element e-flexbox-base e-ykrhga-e00044-s " data-id="e00044" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e00044">
    
</div>
<div class="elementor-element elementor-element-e00045 e-con e-atomic-element e-flexbox-base e-ykrhga-e00045-s " data-id="e00045" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e00045">
    			<p class="e-ykrhga-e00046-s e-paragraph-base" data-interaction-id="e00046">18:00</p>
					<p class="e-ykrhga-e00047-s e-paragraph-base" data-interaction-id="e00047">Books out first, usually eleven days ahead.</p>
		
</div>

</div>

</div>
<div class="elementor-element elementor-element-e00048 e-con e-atomic-element e-flexbox-base e-ykrhga-e00048-s " data-id="e00048" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e00048">
    			<p class="e-ykrhga-e00049-s e-paragraph-base" data-interaction-id="e00049">Price</p>
					<p class="e-ykrhga-e0004a-s e-paragraph-base" data-interaction-id="e0004a">48</p>
					<p class="e-ykrhga-e0004b-s e-paragraph-base" data-interaction-id="e0004b">For three hours, including a towel, a robe and as much cold water as you can drink.</p>
		<div class="elementor-element elementor-element-e0004c e-con e-atomic-element e-flexbox-base e-ykrhga-e0004c-s " data-id="e0004c" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0004c">
    
</div>
			<p class="e-ykrhga-e0004d-s e-paragraph-base" data-interaction-id="e0004d">Ten-session card for 400. The 6am session is the quietest and the 6pm one books out first.</p>
		
</div>

</div>

</section>
<section class="elementor-element elementor-element-e0004e e-con e-atomic-element e-flexbox-base e-ykrhga-e0004e-s " data-id="e0004e" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0004e">
    <div class="elementor-element elementor-element-e0004f e-con e-atomic-element e-grid-base e-ykrhga-e0004f-s " data-id="e0004f" data-element_type="e-grid" data-e-type="e-grid" data-interaction-id="e0004f">
    <div class="elementor-element elementor-element-e0004g e-con e-atomic-element e-flexbox-base e-ykrhga-e0004g-s " data-id="e0004g" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0004g">
    			<p class="e-ykrhga-e0004h-s e-paragraph-base" data-interaction-id="e0004h">Accessibility</p>
					<h2 data-interaction-id="e0004i" class="e-ykrhga-e0004i-s e-heading-base">What we can adapt, and what we cannot.</h2>
					<p class="e-ykrhga-e0004j-s e-paragraph-base" data-interaction-id="e0004j">The building is one level below the street with a lift from the lockers to every pool deck. Ask us anything before you pay.</p>
		
</div>
<div class="elementor-element elementor-element-e0004k e-con e-atomic-element e-grid-base e-ykrhga-e0004k-s " data-id="e0004k" data-element_type="e-grid" data-e-type="e-grid" data-interaction-id="e0004k">
    <div class="elementor-element elementor-element-e0004l e-con e-atomic-element e-flexbox-base e-ykrhga-e0004l-s " data-id="e0004l" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0004l">
    <div class="elementor-element elementor-element-e0004m e-con e-atomic-element e-flexbox-base e-ykrhga-e0004m-s " data-id="e0004m" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0004m">
    
</div>
			<h3 data-interaction-id="e0004n" class="e-ykrhga-e0004n-s e-heading-base">Step-free to the water</h3>
					<p class="e-ykrhga-e0004o-s e-paragraph-base" data-interaction-id="e0004o">Ramped entry to the Source and the Long Pool, with a hoist and a trained attendant at both.</p>
		
</div>
<div class="elementor-element elementor-element-e0004p e-con e-atomic-element e-flexbox-base e-ykrhga-e0004p-s " data-id="e0004p" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0004p">
    <div class="elementor-element elementor-element-e0004q e-con e-atomic-element e-flexbox-base e-ykrhga-e0004q-s " data-id="e0004q" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0004q">
    
</div>
			<h3 data-interaction-id="e0004r" class="e-ykrhga-e0004r-s e-heading-base">Private changing</h3>
					<p class="e-ykrhga-e0004s-s e-paragraph-base" data-interaction-id="e0004s">Two single-occupancy step-free rooms with a bench, a call button and a locker at seated height.</p>
		
</div>
<div class="elementor-element elementor-element-e0004t e-con e-atomic-element e-flexbox-base e-ykrhga-e0004t-s " data-id="e0004t" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0004t">
    <div class="elementor-element elementor-element-e0004u e-con e-atomic-element e-flexbox-base e-ykrhga-e0004u-s " data-id="e0004u" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0004u">
    
</div>
			<h3 data-interaction-id="e0004v" class="e-ykrhga-e0004v-s e-heading-base">Silence, adapted</h3>
					<p class="e-ykrhga-e0004w-s e-paragraph-base" data-interaction-id="e0004w">We agree hand signals with you at the threshold, so nobody has to speak to ask for anything.</p>
		
</div>
<div class="elementor-element elementor-element-e0004x e-con e-atomic-element e-flexbox-base e-ykrhga-e0004x-s " data-id="e0004x" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0004x">
    <div class="elementor-element elementor-element-e0004y e-con e-atomic-element e-flexbox-base e-ykrhga-e0004y-s " data-id="e0004y" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0004y">
    
</div>
			<h3 data-interaction-id="e0004z" class="e-ykrhga-e0004z-s e-heading-base">Tell us first</h3>
					<p class="e-ykrhga-e00050-s e-paragraph-base" data-interaction-id="e00050">Write to us before you book and we will say plainly what we can adapt and what we cannot.</p>
		
</div>

</div>

</div>

</section>
<section class="elementor-element elementor-element-e00051 e-con e-atomic-element e-flexbox-base e-ykrhga-e00051-s " data-id="e00051" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e00051" id="reserve">
    <div class="elementor-element elementor-element-e00052 e-con e-atomic-element e-grid-base e-ykrhga-e00052-s " data-id="e00052" data-element_type="e-grid" data-e-type="e-grid" data-interaction-id="e00052">
    <div class="elementor-element elementor-element-e00053 e-con e-atomic-element e-flexbox-base e-ykrhga-e00053-s " data-id="e00053" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e00053">
    			<img decoding="async" class="e-image-base e-ykrhga-e00054-s" data-interaction-id="e00054" id="164" src="http://127.0.0.1:8950/wp-content/uploads/2026/08/exjsx-onsen-mirador-onsen_cold_well.jpg" width="512" height="512" srcset="http://127.0.0.1:8950/wp-content/uploads/2026/08/exjsx-onsen-mirador-onsen_cold_well.jpg 512w, http://127.0.0.1:8950/wp-content/uploads/2026/08/exjsx-onsen-mirador-onsen_cold_well-300x300.jpg 300w, http://127.0.0.1:8950/wp-content/uploads/2026/08/exjsx-onsen-mirador-onsen_cold_well-150x150.jpg 150w" alt="The cold well, a small dark plunge pool at six degrees"/>		
</div>
<div class="elementor-element elementor-element-e00055 e-con e-atomic-element e-flexbox-base e-ykrhga-e00055-s " data-id="e00055" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e00055">
    			<p class="e-ykrhga-e00056-s e-paragraph-base" data-interaction-id="e00056">Reserve</p>
					<h2 data-interaction-id="e00057" class="e-ykrhga-e00057-s e-heading-base">Three hours, forty bathers, one door.</h2>
					<p class="e-ykrhga-e00058-s e-paragraph-base" data-interaction-id="e00058">Choose a session and arrive fifteen minutes before it starts. Lockers, towel and robe are waiting; phones stay behind at the threshold and the rest is water.</p>
		<div class="elementor-element elementor-element-e00059 e-con e-atomic-element e-flexbox-base e-ykrhga-e00059-s " data-id="e00059" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e00059">
    			<p class="e-ykrhga-e0005a-s e-paragraph-base" data-interaction-id="e0005a"><a href="#reserve" target="_self" class="e-paragraph-link-base">
		Reserve a session
	</a></p>
					<p class="e-ykrhga-e0005b-s e-paragraph-base" data-interaction-id="e0005b">06:00 · 09:00 · 12:00 · 15:00 · 18:00</p>
		
</div>
<div class="elementor-element elementor-element-e0005c e-con e-atomic-element e-flexbox-base e-ykrhga-e0005c-s " data-id="e0005c" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0005c">
    
</div>
			<p class="e-ykrhga-e0005d-s e-paragraph-base" data-interaction-id="e0005d">Onsen Mirador · Silent bathing since the spring was capped. No treatments, no bar, no music.</p>
		
</div>

</div>

</section>

</div>
