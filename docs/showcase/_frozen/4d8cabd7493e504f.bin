    			<img decoding="async" class="e-image-base e-ykrhga-e0007l-s" data-interaction-id="e0007l" id="72" src="http://127.0.0.1:8950/wp-content/uploads/2026/08/exjsx-commonground-trust-meadow_wide.jpg" width="1024" height="576" srcset="http://127.0.0.1:8950/wp-content/uploads/2026/08/exjsx-commonground-trust-meadow_wide.jpg 1024w, http://127.0.0.1:8950/wp-content/uploads/2026/08/exjsx-commonground-trust-meadow_wide-300x169.jpg 300w, http://127.0.0.1:8950/wp-content/uploads/2026/08/exjsx-commonground-trust-meadow_wide-768x432.jpg 768w" alt="Wide view of unploughed floodplain meadow along the river Wenn"/>		
</div>
<div class="elementor-element elementor-element-e0007m e-con e-atomic-element e-flexbox-base e-ykrhga-e0007m-s " data-id="e0007m" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0007m">
    <div class="elementor-element elementor-element-e0007n e-con e-atomic-element e-flexbox-base e-ykrhga-e0007n-s " data-id="e0007n" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0007n">
    <div class="elementor-element elementor-element-e0007o e-con e-atomic-element e-flexbox-base e-ykrhga-e0007o-s " data-id="e0007o" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0007o">
    <div class="elementor-element elementor-element-e0007p e-con e-atomic-element e-flexbox-base e-ykrhga-e0007p-s " data-id="e0007p" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0007p">
    
</div>
			<p class="e-ykrhga-e0007q-s e-paragraph-base" data-interaction-id="e0007q">08 — STANDING ORDER</p>
		
</div>
<div class="elementor-element elementor-element-e0007r e-con e-atomic-element e-grid-base e-ykrhga-e0007r-s " data-id="e0007r" data-element_type="e-grid" data-e-type="e-grid" data-interaction-id="e0007r">
    <div class="elementor-element elementor-element-e0007s e-con e-atomic-element e-flexbox-base e-ykrhga-e0007s-s " data-id="e0007s" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0007s">
    			<h2 data-interaction-id="e0007t" class="e-ykrhga-e0007t-s e-heading-base">Protect an acre.</h2>
					<p class="e-ykrhga-e0007u-s e-paragraph-base" data-interaction-id="e0007u">A standing order is the only thing that lets us bid before a parcel goes to auction. It is the difference between the 217 acres and the 96.</p>
		<div class="elementor-element elementor-element-e0007v e-con e-atomic-element e-flexbox-base e-ykrhga-e0007v-s " data-id="e0007v" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0007v">
    			<p class="e-ykrhga-e0007w-s e-paragraph-base" data-interaction-id="e0007w">No newsletter unless you ask. No telephone calls, ever. Cancel at your bank without telling us — we will not chase you.</p>
					<p class="e-ykrhga-e0007x-s e-paragraph-base" data-interaction-id="e0007x">Gift Aid adds 25p to every pound if you are a UK taxpayer, and it costs you nothing.</p>
		
</div>

</div>
<div class="elementor-element elementor-element-e0007y e-con e-atomic-element e-flexbox-base e-ykrhga-e0007y-s " data-id="e0007y" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0007y">
    			<p class="e-ykrhga-e0007z-s e-paragraph-base" data-interaction-id="e0007z">CHOOSE A MONTHLY AMOUNT</p>
		<div class="elementor-element elementor-element-e00080 e-con e-atomic-element e-grid-base e-ykrhga-e00080-s " data-id="e00080" data-element_type="e-grid" data-e-type="e-grid" data-interaction-id="e00080">
    <div class="elementor-element elementor-element-e00081 e-con e-atomic-element e-flexbox-base e-ykrhga-e00081-s " data-id="e00081" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e00081">
    <div class="elementor-element elementor-element-e00082 e-con e-atomic-element e-flexbox-base e-ykrhga-e00082-s " data-id="e00082" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e00082">
    			<p class="e-ykrhga-e00083-s e-paragraph-base" data-interaction-id="e00083">£6</p>
					<p class="e-ykrhga-e00084-s e-paragraph-base" data-interaction-id="e00084">a month</p>
		
</div>
			<p class="e-ykrhga-e00085-s e-paragraph-base" data-interaction-id="e00085">protects 20 m² a year</p>
		
</div>
<div class="elementor-element elementor-element-e00086 e-con e-atomic-element e-flexbox-base e-ykrhga-e00086-s " data-id="e00086" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e00086">
    <div class="elementor-element elementor-element-e00087 e-con e-atomic-element e-flexbox-base e-ykrhga-e00087-s " data-id="e00087" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e00087">
    			<p class="e-ykrhga-e00088-s e-paragraph-base" data-interaction-id="e00088">£12</p>
					<p class="e-ykrhga-e00089-s e-paragraph-base" data-interaction-id="e00089">a month</p>
		
</div>
			<p class="e-ykrhga-e0008a-s e-paragraph-base" data-interaction-id="e0008a">protects 40 m² a year</p>
		
</div>
<div class="elementor-element elementor-element-e0008b e-con e-atomic-element e-flexbox-base e-ykrhga-e0008b-s " data-id="e0008b" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0008b">
    <div class="elementor-element elementor-element-e0008c e-con e-atomic-element e-flexbox-base e-ykrhga-e0008c-s " data-id="e0008c" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0008c">
    			<p class="e-ykrhga-e0008d-s e-paragraph-base" data-interaction-id="e0008d">£25</p>
					<p class="e-ykrhga-e0008e-s e-paragraph-base" data-interaction-id="e0008e">a month</p>
		
</div>
			<p class="e-ykrhga-e0008f-s e-paragraph-base" data-interaction-id="e0008f">protects 83 m² a year</p>
		
</div>
<div class="elementor-element elementor-element-e0008g e-con e-atomic-element e-flexbox-base e-ykrhga-e0008g-s " data-id="e0008g" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0008g">
    <div class="elementor-element elementor-element-e0008h e-con e-atomic-element e-flexbox-base e-ykrhga-e0008h-s " data-id="e0008h" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0008h">
    			<p class="e-ykrhga-e0008i-s e-paragraph-base" data-interaction-id="e0008i">£50</p>
					<p class="e-ykrhga-e0008j-s e-paragraph-base" data-interaction-id="e0008j">a month</p>
		
</div>
			<p class="e-ykrhga-e0008k-s e-paragraph-base" data-interaction-id="e0008k">protects 167 m² a year</p>
		
</div>

</div>
