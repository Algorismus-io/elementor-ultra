    			<p class="e-ykrhga-e0004i-s e-paragraph-base" data-interaction-id="e0004i">WEIGHT TICKET</p>
					<p class="e-ykrhga-e0004j-s e-paragraph-base" data-interaction-id="e0004j">Scanned at the weighbridge, held against the load.</p>
		
</div>
<div class="elementor-element elementor-element-e0004k e-con e-atomic-element e-flexbox-base e-ykrhga-e0004k-s " data-id="e0004k" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0004k">
    			<p class="e-ykrhga-e0004l-s e-paragraph-base" data-interaction-id="e0004l">DEFECT REPORT</p>
