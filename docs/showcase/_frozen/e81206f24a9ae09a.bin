</section>
<section class="elementor-element elementor-element-e0002m e-con e-atomic-element e-flexbox-base e-ykrhga-e0002m-s " data-id="e0002m" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0002m">
    <div class="elementor-element elementor-element-e0002n e-con e-atomic-element e-flexbox-base e-ykrhga-e0002n-s " data-id="e0002n" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0002n">
    			<p class="e-ykrhga-e0002o-s e-paragraph-base" data-interaction-id="e0002o">Stated once</p>
		<div class="elementor-element elementor-element-e0002p e-con e-atomic-element e-flexbox-base e-ykrhga-e0002p-s " data-id="e0002p" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0002p">
    			<h2 data-interaction-id="e0002q" class="e-ykrhga-e0002q-s e-heading-base">Cut-off 9pm. Delivery between 4am and 6am.</h2>
					<p class="e-ykrhga-e0002r-s e-paragraph-base" data-interaction-id="e0002r">Chilled, into your walk-in if you leave it open. One van, one driver, the same one every day.</p>
		
</div>
<div class="elementor-element elementor-element-e0002s e-con e-atomic-element e-grid-base e-ykrhga-e0002s-s " data-id="e0002s" data-element_type="e-grid" data-e-type="e-grid" data-interaction-id="e0002s">
    <div class="elementor-element elementor-element-e0002t e-con e-atomic-element e-flexbox-base e-ykrhga-e0002t-s " data-id="e0002t" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0002t">
    			<p class="e-ykrhga-e0002u-s e-paragraph-base" data-interaction-id="e0002u">9pm</p>
					<p class="e-ykrhga-e0002v-s e-paragraph-base" data-interaction-id="e0002v">Order closes</p>
		
</div>
<div class="elementor-element elementor-element-e0002w e-con e-atomic-element e-flexbox-base e-ykrhga-e0002w-s " data-id="e0002w" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0002w">
    			<p class="e-ykrhga-e0002x-s e-paragraph-base" data-interaction-id="e0002x">10pm</p>
					<p class="e-ykrhga-e0002y-s e-paragraph-base" data-interaction-id="e0002y">Growers see the pick list</p>
		
</div>
<div class="elementor-element elementor-element-e0002z e-con e-atomic-element e-flexbox-base e-ykrhga-e0002z-s " data-id="e0002z" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0002z">
    			<p class="e-ykrhga-e00030-s e-paragraph-base" data-interaction-id="e00030">4am</p>
					<p class="e-ykrhga-e00031-s e-paragraph-base" data-interaction-id="e00031">Van loaded, chilled</p>
		
</div>
<div class="elementor-element elementor-element-e00032 e-con e-atomic-element e-flexbox-base e-ykrhga-e00032-s " data-id="e00032" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e00032">
    			<p class="e-ykrhga-e00033-s e-paragraph-base" data-interaction-id="e00033">6am</p>
					<p class="e-ykrhga-e00034-s e-paragraph-base" data-interaction-id="e00034">At your back door</p>
		
</div>

</div>

</div>

</section>
<section class="elementor-element elementor-element-e00035 e-con e-atomic-element e-flexbox-base e-ykrhga-e00035-s " data-id="e00035" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e00035">
    <div class="elementor-element elementor-element-e00036 e-con e-atomic-element e-flexbox-base e-ykrhga-e00036-s " data-id="e00036" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e00036">
    <div class="elementor-element elementor-element-e00037 e-con e-atomic-element e-flexbox-base e-ykrhga-e00037-s " data-id="e00037" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e00037">
    			<p class="e-ykrhga-e00038-s e-paragraph-base" data-interaction-id="e00038">Growers on the platform</p>
					<h2 data-interaction-id="e00039" class="e-ykrhga-e00039-s e-heading-base">46 producers, average distance 61km.</h2>
					<p class="e-ykrhga-e0003a-s e-paragraph-base" data-interaction-id="e0003a">Every listing shows the farm name, the distance, and when it was cut or lifted. If a grower is having a bad week you will see it on the listing before you order it.</p>
					<img decoding="async" class="e-image-base e-ykrhga-e0003b-s" data-interaction-id="e0003b" id="86" src="http://127.0.0.1:8950/wp-content/uploads/2026/08/exjsx-field-to-pass-grower.jpg" width="768" height="1024" srcset="http://127.0.0.1:8950/wp-content/uploads/2026/08/exjsx-field-to-pass-grower.jpg 768w, http://127.0.0.1:8950/wp-content/uploads/2026/08/exjsx-field-to-pass-grower-225x300.jpg 225w" alt="A grower in the field, crates of just-lifted produce beside them"/>		
</div>
