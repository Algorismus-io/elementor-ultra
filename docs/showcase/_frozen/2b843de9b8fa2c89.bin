<section class="elementor-element elementor-element-e0008n e-con e-atomic-element e-flexbox-base e-hu2hyx-e0008n-s " data-id="e0008n" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0008n">
    <div class="elementor-element elementor-element-e0008o e-con e-atomic-element e-flexbox-base e-hu2hyx-e0008o-s " data-id="e0008o" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0008o">
    <div class="elementor-element elementor-element-e0008p e-con e-atomic-element e-flexbox-base e-hu2hyx-e0008p-s " data-id="e0008p" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0008p">
    			<p class="e-hu2hyx-e0008q-s e-paragraph-base" data-interaction-id="e0008q">07 — PRICING</p>
					<h2 data-interaction-id="e0008r" class="e-hu2hyx-e0008r-s e-heading-base">Per seat, with unlimited documents</h2>
		
</div>
<div class="elementor-element elementor-element-e0008s e-con e-atomic-element e-grid-base e-hu2hyx-e0008s-s " data-id="e0008s" data-element_type="e-grid" data-e-type="e-grid" data-interaction-id="e0008s">
    <div class="elementor-element elementor-element-e0008t e-con e-atomic-element e-flexbox-base e-hu2hyx-e0008t-s " data-id="e0008t" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0008t">
    <div class="elementor-element elementor-element-e0008u e-con e-atomic-element e-flexbox-base e-hu2hyx-e0008u-s " data-id="e0008u" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0008u">
    			<h3 data-interaction-id="e0008v" class="e-hu2hyx-e0008v-s e-heading-base">£340</h3>
					<p class="e-hu2hyx-e0008w-s e-paragraph-base" data-interaction-id="e0008w">/seat/month</p>
		
</div>
			<p class="e-hu2hyx-e0008x-s e-paragraph-base" data-interaction-id="e0008x">Unlimited documents. Billed annually, invoiced to legal ops, no per-contract meter to explain to finance.</p>
					<p class="e-hu2hyx-e0008y-s e-paragraph-base" data-interaction-id="e0008y"><a href="#book" target="_self" class="e-paragraph-link-base">
		Book a playbook session
	</a></p>
		
</div>
<div class="elementor-element elementor-element-e0008z e-con e-atomic-element e-flexbox-base e-hu2hyx-e0008z-s " data-id="e0008z" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e0008z">
    			<p class="e-hu2hyx-e00090-s e-paragraph-base" data-interaction-id="e00090">£340 per seat per month with unlimited documents, because charging per contract makes your team hesitate to use it and that defeats the purpose.</p>
		<div class="elementor-element elementor-element-e00091 e-con e-atomic-element e-flexbox-base e-hu2hyx-e00091-s " data-id="e00091" data-element_type="e-flexbox" data-e-type="e-flexbox" data-interaction-id="e00091">
    
